# ─────────────────────────────────────────────────────────────────────────────
# Sealed Launchpad web (apps/web). Copy to apps/web/.env.local for local dev.
# On Vercel set these in Project → Settings → Environment Variables.
# All NEXT_PUBLIC_* values are inlined at build time — redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public site URL (metadataBase, canonical links, sitemap, robots, OG). Production:
NEXT_PUBLIC_SITE_URL=https://www.sealedsol.xyz

# Backend REST base (no trailing slash) and WebSocket endpoint.
# Production (Railway): https://api-production-01dc1743.up.railway.app  /  wss://api-production-01dc1743.up.railway.app/ws
# Local dev: http://localhost:4000  /  ws://localhost:4000/ws
NEXT_PUBLIC_API_URL=https://api-production-01dc1743.up.railway.app
NEXT_PUBLIC_WS_URL=wss://api-production-01dc1743.up.railway.app/ws

# devnet | mainnet | localnet  (anything but mainnet shows the Devnet/Demo label)
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Written by scripts/deploy-devnet.sh
NEXT_PUBLIC_PROGRAM_ID=71geDPZMKfjJnKE4an15QyyH5TyFG1w7XEL5tUkp5Tpy

# WalletConnect / Reown project id (public, not a secret). Enables the WalletConnect option (QR on desktop,
# wallet-app deep link on phones; Jupiter Mobile, Trust, OKX, ...). Create one free at https://cloud.reown.com and add
# your site domain to its allowlist. Leave empty to hide the option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional overrides
NEXT_PUBLIC_JUPITER_API_URL=https://quote-api.jup.ag/v6
# JSON map of devnet quote mints, e.g. {"USDC":"<mint>","NVDAx":"<mint>"} (written by the devnet init script)
NEXT_PUBLIC_DEVNET_MINTS=
