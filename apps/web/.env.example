# ─────────────────────────────────────────────────────────────────────────────
# Sealed Launchpad web (apps/web). Copy to apps/web/.env.local for local dev.
# On Vercel set these in Project → Settings → Environment Variables.
# All NEXT_PUBLIC_* values are inlined at build time — redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# Backend REST base (no trailing slash) and WebSocket endpoint
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# devnet | mainnet | localnet  (anything but mainnet shows the Devnet/Demo label)
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Written by scripts/deploy-devnet.sh
NEXT_PUBLIC_PROGRAM_ID=71geDPZMKfjJnKE4an15QyyH5TyFG1w7XEL5tUkp5Tpy

# Optional overrides
NEXT_PUBLIC_JUPITER_API_URL=https://quote-api.jup.ag/v6
# JSON map of devnet quote mints, e.g. {"USDC":"<mint>","NVDAx":"<mint>"} (written by the devnet init script)
NEXT_PUBLIC_DEVNET_MINTS=
