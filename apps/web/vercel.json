{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @sealed/shared build && pnpm --filter @sealed/defi build && pnpm --filter @sealed/web build",
  "outputDirectory": ".next",
  "build": {
    "env": {
      "NEXT_PUBLIC_SITE_URL": "https://www.sealedsol.xyz",
      "NEXT_PUBLIC_API_URL": "https://api-production-01dc1743.up.railway.app",
      "NEXT_PUBLIC_WS_URL": "wss://api-production-01dc1743.up.railway.app/ws",
      "NEXT_PUBLIC_NETWORK": "devnet"
    }
  }
}
