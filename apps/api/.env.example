# ─────────────────────────────────────────────────────────────────────────────
# Sealed Launchpad API (apps/api). Copy to apps/api/.env for local dev.
# Every variable is optional: with none set the API boots in DEMO_MODE with an
# in-memory store + demo world (no Postgres, Redis or RPC required).
# On Railway, set these on the API service; ${{…}} are Railway reference variables.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP / WS listener (Railway injects PORT automatically)
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Demo mode. Defaults to true when SOLANA_RPC_URL is unset. Set false on devnet/mainnet.
DEMO_MODE=
# Demo simulation tick interval (ms)
DEMO_TICK_MS=1000
# Run indexer / reveal relayer / buyback keeper workers in-process
WORKERS_ENABLED=true

# Postgres (optional → memory store). Railway: add the Postgres plugin and reference it.
# Railway value: ${{Postgres.DATABASE_URL}}   Local example: postgresql://postgres:postgres@localhost:5432/sealed
DATABASE_URL=
# Redis (optional → in-memory cache/queues). Railway: add the Redis plugin and reference it.
# Railway value: ${{Redis.REDIS_URL}}         Local example: redis://localhost:6379
REDIS_URL=

# Solana
NETWORK=devnet
# Explicit RPC wins; otherwise HELIUS_API_KEY builds https://<network>.helius-rpc.com/?api-key=…
# Setting this switches DEMO_MODE off by default. Devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=
SOLANA_WS_URL=
HELIUS_API_KEY=
# Written by scripts/deploy-devnet.sh
PROGRAM_ID=71geDPZMKfjJnKE4an15QyyH5TyFG1w7XEL5tUkp5Tpy
# Optional explicit IDL path (defaults to programs/sealed-launchpad/idl/sealed_launchpad.json)
IDL_PATH=

# Auto-reveal relayer
# base58 ed25519 secret key (64 bytes) of the fee payer that submits reveal_bid txs. Keep it funded, keep it small.
RELAYER_SECRET_KEY=
# 32-byte hex seed for the relayer's x25519 box keypair (users seal reveal payloads to its pubkey).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAYER_BOX_SEED=

# Buyback keeper (permissionless crank signer for execute_buyback_drip / distribute_rewards)
KEEPER_SECRET_KEY=

# Jupiter v6 quote API
JUPITER_API_URL=https://quote-api.jup.ag/v6

# CORS: "*" or comma-separated origins. Production: https://www.sealedsol.xyz,https://sealedsol.xyz
# (add http://localhost:3000 for local web dev against this API)
CORS_ORIGIN=https://www.sealedsol.xyz,https://sealedsol.xyz

# ── Offchain custody (wallet sign-in, deposits, withdrawals, proof of reserves) ──────────────────────
# offchain (default): Postgres ledger + company-wallet custody. onchain: future non-custodial Anchor mode.
EXECUTION_MODE=offchain
# Company wallet that receives deposits and sends payouts. Defaults to the shared constant
# DDhVBh8HSwvYmCmXRowowUdDLcCc5vA9BM3GJMR3hm1j — only override if you rotate the wallet everywhere.
COMPANY_WALLET=
# Secret key of COMPANY_WALLET (base58 64-byte key, or solana-keygen JSON byte array). SECRET — set only in the
# host's secret store, never commit. Unset → payouts disabled (withdrawals stay `queued`). Must derive to
# COMPANY_WALLET or payouts are refused at startup.
COMPANY_WALLET_SECRET_KEY=
# Shared secret for /api/admin/* (send as header `x-admin-token`). Unset → admin routes return 503.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
# Deposit finality: "finalized" (default) or an integer number of confirmed slots of depth.
DEPOSIT_CONFIRMATIONS=finalized
# Domain shown in the Sign-In-With-Solana message (e.g. sealedsol.xyz).
SIWS_DOMAIN=
# Run DepositWatcher + PayoutWorker in-process (default: WORKERS_ENABLED and not demo). Poll intervals in ms.
CUSTODY_WORKERS=
DEPOSIT_POLL_MS=15000
PAYOUT_POLL_MS=10000
# Sessions are random 32-byte tokens stored as SHA-256 hashes; no SESSION_SECRET is needed.
