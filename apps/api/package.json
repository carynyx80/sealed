{
  "name": "@sealed/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@fastify/cors": "10.0.1",
    "@fastify/websocket": "11.0.1",
    "@prisma/client": "5.22.0",
    "@sealed/shared": "workspace:*",
    "@solana/web3.js": "1.98.0",
    "bs58": "6.0.0",
    "fastify": "5.1.0",
    "ioredis": "5.4.1",
    "tweetnacl": "1.0.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/ws": "8.5.13",
    "pino-pretty": "13.0.0",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
