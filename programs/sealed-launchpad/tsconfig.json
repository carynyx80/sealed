{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "es2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts"]
}
