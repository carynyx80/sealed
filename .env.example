# ─────────────────────────────────────────────────────────────────────────────
# Sealed Launchpad monorepo — root env (used by scripts/*.sh).
# App-specific variables live in apps/api/.env.example and apps/web/.env.example.
# Nothing here is required for `pnpm install && pnpm dev` (demo mode).
# ─────────────────────────────────────────────────────────────────────────────

# Solana devnet deploy (scripts/deploy-devnet.sh)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Deployer / upgrade-authority keypair file
ANCHOR_WALLET=~/.config/solana/id.json
# Program id (kept in sync by deploy-devnet.sh → also written to apps/api/.env and apps/web/.env.local)
PROGRAM_ID=71geDPZMKfjJnKE4an15QyyH5TyFG1w7XEL5tUkp5Tpy

# Railway (scripts/deploy-api.sh) — `railway login` or a project token
RAILWAY_TOKEN=
RAILWAY_SERVICE=sealed-api
RAILWAY_ENVIRONMENT=production

# Vercel (scripts/deploy-web.sh) — `vercel login` or a token
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
